{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#7aa2f7",
          "template": "{{ .Path }}",
          "properties": {
            "style": "full",
            "home_icon": "~"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#bb9af7",
          "template": " on  {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} <#e0af68> {{ .Working.String }}</>{{ end }}{{ if .Staging.Changed }} <#9ece6a> {{ .Staging.String }}</>{{ end }}",
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "segments": [
        {
          "type": "node",
          "style": "plain",
          "foreground": "#565f89",
          "template": " {{ .Full }}",
          "properties": {
            "fetch_version": true,
            "display_mode": "files"
          }
        },
        {
          "type": "dotnet",
          "style": "plain",
          "foreground": "#565f89",
          "template": "   {{ if .Unsupported }}{{ else }}{{ .Full }}{{ end }}",
          "properties": {
            "fetch_version": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "exit",
          "style": "plain",
          "foreground": "#9ece6a",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#f7768e{{ end }}"
          ],
          "template": "❯",
          "properties": {
            "always_enabled": true
          }
        }
      ]
    }
  ]
}
